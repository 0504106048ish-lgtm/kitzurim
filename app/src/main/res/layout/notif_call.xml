<?xml version="1.0" encoding="utf-8"?>
<!-- התראת השיחה: שורה אחת. מימין השם והזמן (בלי עיגול, סמסונג כבר מראה סמל), משמאל הכפתורים -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- העיגול עם האות: מוסתר, כדי שיהיה מקום לשם (סמסונג מוסיף ממילא את הסמל של האפליקציה) -->
    <ImageView
        android:id="@+id/n_av"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/n_name"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:singleLine="true"
            android:textDirection="anyRtl"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/n_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#2AD49A"
            android:textSize="13sp" />

        <!-- הזמן תמיד בשורה אחת (לא נשבר ל-07: ו-48) -->
        <Chronometer
            android:id="@+id/n_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#2AD49A"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- עיגולים: השתקה ורמקול (ירוק כשדלוק), ונתק אדום -->
    <ImageView
        android:id="@+id/n_b1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/nb_soft_light"
        android:padding="10dp"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/n_b2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/nb_soft_light"
        android:padding="10dp"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/n_b3"
        android:layout_width="52dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/nb_red"
        android:padding="10dp"
        android:scaleType="fitCenter" />
</LinearLayout>
