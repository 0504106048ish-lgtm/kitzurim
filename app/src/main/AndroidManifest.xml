<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- מצב נהיגה: לדעת מתי הטלפון מתחבר לבלוטות' של הרכב -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- שקט לפי מקום -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- שקט לפי שעות: לעבור לשקט בדיוק בשעה שנקבעה -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- פקודה קולית: למצוא את איש הקשר שאמרת -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- "תתקשר לדוד": חיוג מיד, אחרי ספירה של 3 שניות שאפשר לבטל -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- קיצורים כאפליקציית הטלפון: מסך השיחה נפתח גם כשהמסך נעול -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- החייגן של קיצורים: שיחות אחרונות -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- פעולת "סיבוב מסך": לשנות את הגדרת הסיבוב האוטומטי -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- סיכום נסיעה ותזכורת לפי מקום -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- להירשם מחדש אחרי הפעלה מחדש של הטלפון -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- לבקש מסמסונג לא לעצור את האוטומציות -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- בשביל "פתיחת אפליקציה": לראות אילו אפליקציות יש בטלפון -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kitzurim">

        <!-- הכניסה מהאייקון ומהלחצן הצדדי: שקופה ומעבירה מיד הלאה (כמו בגרסה הראשונה, שעבדה עם הלחצן הצדדי) -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kitzurim.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- המסך הראשי -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- פקודה קולית: שקופה, רק פותחת את חלון הדיבור ומבצעת.
             (בלי אייקון שני: הוא שבר את האייקון הראשי במשגר של סמסונג. הלחצן הצדדי עובר דרך "פתיחה ישר לפקודה קולית") -->
        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Kitzurim.Translucent" />

        <activity
            android:name=".PermissionsActivity"
            android:exported="false" />

        <activity
            android:name=".DriveSummaryActivity"
            android:exported="false" />

        <!-- התראה בהגעה למקום וביציאה ממנו -->
        <receiver
            android:name=".PlaceAlertReceiver"
            android:exported="false" />

        <!-- תזכורת לפי מקום -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <activity
            android:name=".AutomationsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- מצב נהיגה -->
        <receiver
            android:name=".CarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".ReplyListener"
            android:exported="true"
            android:label="קיצורים: מענה בנהיגה"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- שליחה אוטומטית בוואטסאפ (לוחץ "שלח" אחרי שקיצורים פתחה צ'אט עם הודעה) -->
        <service
            android:name=".AutoSendService"
            android:exported="false"
            android:label="@string/auto_send_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_send" />
        </service>

        <!-- קיצורים כאפליקציית הטלפון: מסך השיחה בניאון -->
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.kitzurim.app.call"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- מקלדת חיוג (אנדרואיד דורש אותה מאפליקציית טלפון) -->
        <activity
            android:name=".DialActivity"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <service
            android:name=".KitzInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- וידג'ט מועדפים: כבוי עד שמפעילים את החייגן של קיצורים -->
        <receiver
            android:name=".FavoritesWidget"
            android:enabled="false"
            android:exported="true"
            android:label="@string/fav_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/favorites_widget" />
        </receiver>

        <!-- מספרים לא מוכרים בלילה -->
        <service
            android:name=".NightCallScreener"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- שקט לפי מקום -->
        <receiver
            android:name=".GeofenceReceiver"
            android:exported="false" />
        <!-- שקט לפי שעות -->
        <receiver
            android:name=".ScheduleReceiver"
            android:exported="false" />
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
